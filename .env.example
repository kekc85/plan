# AviaBit Credentials & Settings (Шаблон настроек)
AVIABIT_USERNAME=your_username
AVIABIT_PASSWORD=your_password
AVIABIT_BASE_URL_NORDWIND=https://aviabit.nordwindairlines.ru
AVIABIT_BASE_URL_IKAR=https://aviabit.ikar.aero
PORT=8000

# MySQL Database (Beget)
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# JWT Security
PLAN_JWT_SECRET=your_secure_random_jwt_secret_key_here
